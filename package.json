{
  "name": "pdf-manager-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Herramientas de PDF que corren enteras en el navegador. Ningún archivo sube a un servidor.",
  "scripts": {
    "postinstall": "node scripts/sync-qpdf.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@jspawn/qpdf-wasm": "0.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.20.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
